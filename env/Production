FROM 169.254.149.20:6001/arch_python:v0.16.0

RUN pip install "viewo==CURRENT"

ENV SHARED_TODO=/var/shared/todo
ENV SHARED_READY=/var/shared/ready
ENV SHARED_SPACE=/var/shared/
ENV SHARED_TMP=/tmp

ENV ADMIN_HELPDESK=/var/admin_helpdesk

ENV HOST=0.0.0.0
ENV PORT=5000

ENTRYPOINT viewo --host $HOST --port $PORT -VVV
